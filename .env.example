# 视频生成后端：comfyui（默认推荐，连接远端 Colab GPU / 自建 ComfyUI）或 runninghub（回退选项）
VIDEO_PROVIDER=comfyui
# 远端 ComfyUI 隧道或服务地址；支持用英文逗号分隔多个节点地址并行出片（注意：NGROK_AUTHTOKEN 保存在 Google Drive 私密文件 .ngrok_token 中，勿写入本机 .env）
COMFYUI_URL=
# 远端隧道访问密钥（与 Google Drive 私密文件 .comfyui_api_key 保持一致；多 HTTPS 节点共用，本地 HTTP 免密）
COMFYUI_API_KEY=
# ComfyUI 采样预设：full20（默认推荐，原生 20 步 + EasyCache 加速，无 4step LoRA 右漂）/ 8step / 4step（实验草稿）
COMFYUI_PRESET=full20
# ComfyUI 原生分辨率档位：768p（默认推荐，768×1344/1344×768/1024×1024，适合 G4 96GB / H100 / A100 80GB）/ 544p（544×960/960×544/736×736，40GB 显存兼容快速档）
COMFYUI_RESOLUTION=768p
# ComfyUI 2× 写实超分：0（默认关闭，768p 原生直出清晰无磨皮感）/ 1（开启，RealESRGAN_x2plus，适合 544p → 2× 超分）
COMFYUI_UPSCALE=0
# 并发段数上限：留空则自动等于已配置的 ComfyUI 节点数（单节点默认 1，多节点每卡并发 1 段）
# COMFYUI_CONCURRENCY=1
# Colab GPU 规格（G4 固定 96GB Blackwell 推荐 / A100 / H100）、会话名与按需启停策略
COLAB_GPU=G4
COLAB_SESSION=comfy-a100
COLAB_AUTO_START=0
# 可选：自定义 google-colab-cli 路径或凭据模式（Windows 遇凭据长度限制可设 COLAB_AUTH=adc）
# COLAB_BIN=
# COLAB_AUTH=oauth2

# RunningHub（runninghub.cn）回退选项：控制台「API 调用」里的 key
RUNNINGHUB_API_KEY=
# 同时跑几段：默认 3；按实际 API 额度调整，网站任务也会占用会员并发
RUNNINGHUB_CONCURRENCY=3
# 一个 RH 币折多少钱（用来算成本；Max 包月 ¥399 = 18 万币）
# RUNNINGHUB_COIN_CNY=0.002217

# APIMart（apimart.ai）的 key：画分镜图（GPT Image 2.6），默认也用于逐镜头文字描述和视频提示词改写
APIMART_API_KEY=
# 分镜图模型
# IMAGE_MODEL=gpt-image-2.6-sunburst
# 分镜图清晰度和质量：1k / 2k，low / medium / high
# IMAGE_RESOLUTION=1k
# IMAGE_QUALITY=medium

# 提示词改写：auto（装了 Claude Code 就用它）/ claude / llm（任何 OpenAI 兼容接口）
# H3_REWRITER=auto
# CLAUDE_MODEL=opus
# 文字服务：apimart（默认）/ gemini（Gemini 官方 OpenAI 兼容接口）
# 两项文字任务共用所选服务，但模型可分别配置；分镜图片始终使用 APIMart
# LLM_PROVIDER=apimart
# APIMart / 自定义 OpenAI 兼容服务：LLM_MODEL 是未单独配置时的默认模型
# LLM_BASE_URL=https://api.apimart.ai/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-pro
# LLM_COMPOSITION_MODEL=deepseek-v4-pro
# LLM_REWRITE_MODEL=deepseek-v4-pro

# Gemini 官方：将 LLM_PROVIDER 改为 gemini，并填写 Gemini API key
# 固定使用 https://generativelanguage.googleapis.com/v1beta/openai/
# 不使用 LLM_API_KEY / APIMART_API_KEY / LLM_BASE_URL / LLM_MODEL
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_COMPOSITION_MODEL=gemini-flash-latest
# GEMINI_REWRITE_MODEL=gemini-flash-latest

# MiniMax 官方提示词指南默认从 GitHub 现取；网络不通就下载 ref-en.txt 后指过去
# H3_GUIDE_FILE=/path/to/ref-en.txt
